# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/groundwork"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Platform free-tier AI (Google Gemini Flash — free tier)
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-key-here"

# Free tier limits
FREE_DAILY_TOKEN_LIMIT="50000"

# Encryption key for BYOK user keys — generate with: openssl rand -base64 32
ENCRYPTION_KEY="your-32-byte-key-here"

# Local AI grader — llama.cpp server for grading open-ended answers
# Optional — falls back to GOOGLE_GENERATIVE_AI_API_KEY if not set
# See: scripts/setup-grader.sh for setup instructions
LOCAL_GRADER_URL="http://127.0.0.1:8081"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Groundwork"
